{
  "compilerOptions": {
    /* Core */
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* Performance 🔥 */
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo",

    /* Strictness (keep it, but balanced) */
    "strict": true,
    "noUncheckedIndexedAccess": false,

    /* Interop */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Output */
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": false,

    /* Speed tweaks */
    "resolveJsonModule": true,
    "isolatedModules": true
  },

  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}